# Application
PORT=7860
DOWNLOAD_DIR=downloads

# Request and file bounds (bytes / seconds)
MAX_REQUEST_BYTES=65536
MAX_DOWNLOAD_BYTES=536870912
MIN_FREE_DISK_BYTES=1073741824
DOWNLOAD_TTL_SECONDS=3600
MAX_PROXY_IMAGE_BYTES=8388608
MAX_PROXY_REDIRECTS=3
GALLERY_RATE_LIMIT=8

# Completed media storage. Production should use r2; local keeps files on disk.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=omnimedia-downloads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_SECONDS=600
R2_OBJECT_PREFIX=downloads

# Per-process concurrency
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_PARSES=4
# Maximum is hard-capped at 10 by the server.
MAX_BATCH_SIZE=10

# Optional yt-dlp login session for login-required public content.
# Prefer a mounted Netscape-format cookies.txt in deployments. If omitted,
# local runs may auto-read Chrome cookies for Instagram, Twitter/X and Douyin.
YTDLP_COOKIE_FILE=
# Railway/Render-style deployments can use a base64-encoded Netscape
# cookies.txt when a secret file mount is unavailable. Keep this variable
# private; never commit it or paste it into chat.
YTDLP_COOKIE_DATA_B64=
# auto | off | chrome | chromium | firefox | edge ...
YTDLP_COOKIES_FROM_BROWSER=off
# Optional operator-controlled outbound proxy for Instagram/yt-dlp requests.
# Supported schemes: http, https, socks4, socks4a, socks5, socks5h.
YTDLP_PROXY=

# Per-client limits within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_WINDOW_SECONDS=60
PARSE_RATE_LIMIT=20
BATCH_RATE_LIMIT=4
DOWNLOAD_RATE_LIMIT=4
FILE_RATE_LIMIT=60
CLEANUP_RATE_LIMIT=30
PROXY_RATE_LIMIT=60
MAX_RATE_LIMIT_CLIENTS=10000

# Comma-separated browser origins allowed to call /api from another site.
# Same-origin production requests do not need an entry.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Clerk authentication (keep server values private). The issuer is the
# HTTPS issuer shown in Clerk Dashboard > JWT Templates / domain settings.
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# PayPal Subscriptions API. Use sandbox while testing, then switch to live and rotate
# both credentials in Railway Variables/Secrets. Never commit either secret.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_CURRENCY=USD
PAYPAL_PLAN_PRICE=9.90
PAYPAL_PRODUCT_NAME=OmniMedia Monthly Unlimited
PUBLIC_APP_URL=https://useomnimedia.com
# Railway Volume recommended for durable order history; local is fine for dev.
DATABASE_PATH=data/omnimedia.db

# Set to 1 only when exactly one trusted reverse proxy is the app's sole ingress.
TRUST_PROXY=0
