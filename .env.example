# Application
PORT=7860
DOWNLOAD_DIR=downloads

# Request and file bounds (bytes / seconds)
MAX_REQUEST_BYTES=65536
MAX_DOWNLOAD_BYTES=536870912
MIN_FREE_DISK_BYTES=1073741824
DOWNLOAD_TTL_SECONDS=3600
MAX_PROXY_IMAGE_BYTES=8388608
MAX_PROXY_REDIRECTS=3

# Completed media storage. Production should use r2; local keeps files on disk.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=omnimedia-downloads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_SECONDS=600
R2_OBJECT_PREFIX=downloads

# Per-process concurrency
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_PARSES=4
# Maximum is hard-capped at 10 by the server.
MAX_BATCH_SIZE=10

# Optional yt-dlp login session for login-required public content.
# Prefer a mounted Netscape-format cookies.txt in deployments. If omitted,
# local runs may auto-read Chrome cookies for Instagram, Twitter/X and Douyin.
YTDLP_COOKIE_FILE=
# auto | off | chrome | chromium | firefox | edge ...
YTDLP_COOKIES_FROM_BROWSER=off

# Per-client limits within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_WINDOW_SECONDS=60
PARSE_RATE_LIMIT=20
BATCH_RATE_LIMIT=4
DOWNLOAD_RATE_LIMIT=4
FILE_RATE_LIMIT=60
CLEANUP_RATE_LIMIT=30
PROXY_RATE_LIMIT=60
MAX_RATE_LIMIT_CLIENTS=10000

# Comma-separated browser origins allowed to call /api from another site.
# Same-origin production requests do not need an entry.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Set to 1 only when exactly one trusted reverse proxy is the app's sole ingress.
TRUST_PROXY=0
