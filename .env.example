# Application
PORT=7860
DOWNLOAD_DIR=downloads

# Request and file bounds (bytes / seconds)
MAX_REQUEST_BYTES=65536
MAX_DOWNLOAD_BYTES=536870912
MIN_FREE_DISK_BYTES=1073741824
DOWNLOAD_TTL_SECONDS=3600
MAX_PROXY_IMAGE_BYTES=8388608
MAX_PROXY_REDIRECTS=3

# Per-process concurrency
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_PARSES=4

# Per-client limits within RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_WINDOW_SECONDS=60
PARSE_RATE_LIMIT=20
DOWNLOAD_RATE_LIMIT=4
FILE_RATE_LIMIT=60
CLEANUP_RATE_LIMIT=30
PROXY_RATE_LIMIT=60
MAX_RATE_LIMIT_CLIENTS=10000

# Set to 1 only when exactly one trusted reverse proxy is the app's sole ingress.
TRUST_PROXY=0
